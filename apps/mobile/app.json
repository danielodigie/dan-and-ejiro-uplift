{
  "expo": {
    "name": "Dan and Ejiro Uplift",
    "slug": "dan-and-ejiro-uplift",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "uplift",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFDF5"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.danielodigie.uplift"
    },
    "android": {
      "package": "com.danielodigie.uplift",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFC400"
      }
    },
    "plugins": ["expo-router"]
  }
}
