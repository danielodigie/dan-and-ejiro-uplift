DATABASE_URL=postgres://uplift:<password>@localhost:5432/uplift
BETTER_AUTH_SECRET=change-me-to-32-chars-minimum
BETTER_AUTH_URL=http://localhost:3000
API_PORT=3000
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=uplift-files
MOBILE_URL=http://<your-lan-ip>:8081
# Production frontend origin(s) so login cookies work cross-site (Netlify URL). Comma-separated if more than one.
FRONTEND_URL=https://YOUR-SITE.netlify.app
# Gemini LLM (v1.1 optional, behind flag — server-side only, never commit real key)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
LLM_ENABLED=false
# Paystack real payments — SECRET stays server-side only (.env + Render dashboard).
# Public key is safe for frontend use; start with TEST keys (sk_test_/pk_test_).
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
